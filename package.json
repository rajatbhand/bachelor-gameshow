{
  "name": "bachelor-gameshow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_PUBLIC_FIREBASE_ENV=testing next dev",
    "dev:test": "cross-env NEXT_PUBLIC_FIREBASE_ENV=testing next dev",
    "dev:prod": "cross-env NEXT_PUBLIC_FIREBASE_ENV=production next dev",
    "build": "next build",
    "build:test": "cross-env NEXT_PUBLIC_FIREBASE_ENV=testing next build",
    "build:prod": "cross-env NEXT_PUBLIC_FIREBASE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build",
    "export:test": "cross-env NEXT_PUBLIC_FIREBASE_ENV=testing next build",
    "export:prod": "cross-env NEXT_PUBLIC_FIREBASE_ENV=production next build",
    "deploy": "npm run export:prod && firebase deploy -P hosting --only hosting:backup",
    "deploy:test": "npm run export:prod && firebase deploy -P hosting --only hosting:backup",
    "deploy:prod": "npm run export:prod && firebase deploy -P hosting --only hosting:backup",
    "deploy:rules:test": "firebase deploy -P data --only firestore:rules",
    "deploy:rules:prod": "firebase deploy -P data --only firestore:rules",
    "deploy:rules": "firebase deploy -P data --only firestore:rules"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^10.7.1",
    "next": "14.2.31",
    "papaparse": "^5.5.3",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.5.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cross-env": "^7.0.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.31",
    "firebase-tools": "^13.4.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
